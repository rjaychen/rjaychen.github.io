---
interface Props {
  github?: string;
  linkedIn?: string;
  googleScholar?: string;
  size?: number;
  class?: string;
}

const { github, linkedIn, googleScholar, size = 22, class: className = '' } = Astro.props;

const links = [
  { href: github,        src: '/icons/social/github.svg',   label: 'GitHub'         },
  { href: linkedIn,      src: '/icons/social/linkedin.svg', label: 'LinkedIn'       },
  { href: googleScholar, src: '/icons/social/scholar.svg',  label: 'Google Scholar' },
].filter((l) => l.href);
---

<div class:list={['social-links', className]}>
  {links.map((l) => (
    <a href={l.href} aria-label={l.label} target="_blank" rel="noopener noreferrer" class="social-link">
      <img src={l.src} alt="" aria-hidden="true" width={size} height={size} loading="lazy" decoding="async" />
      <span class="visually-hidden">{l.label}</span>
    </a>
  ))}
</div>

<style>
  .social-links {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-panel-border);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .social-link:hover {
    background: var(--color-panel);
    border-color: var(--color-accent-soft);
  }

  .social-link img {
    width: 18px;
    height: 18px;
    object-fit: contain;
    opacity: 0.7;
    transition: opacity 0.15s ease;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .social-link img {
      filter: invert(1);
    }

    :root:not([data-theme='light']) :global(body.page-resume) .social-link img {
      filter: none;
    }
  }

  :root[data-theme='dark'] .social-link img {
    filter: invert(1);
  }

  /* Resume is always a light paper layout — keep icons dark in every theme */
  :root[data-theme='dark'] :global(body.page-resume) .social-link img {
    filter: none;
  }

  .social-link:hover img {
    opacity: 1;
  }
</style>
