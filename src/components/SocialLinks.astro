---
interface Props {
  github?: string;
  linkedIn?: string;
  googleScholar?: string;
  size?: number;
  class?: string;
}

/** Respects `astro.config.mjs` `base`, so icons resolve on GitHub Pages subpaths too. */
const iconUrl = (slug: string) => `${import.meta.env.BASE_URL}icons/social/${slug}.svg`;

const { github, linkedIn, googleScholar, size = 18, class: className = '' } = Astro.props;

const links = [
  { href: github, slug: 'github' as const, label: 'GitHub' },
  { href: linkedIn, slug: 'linkedin' as const, label: 'LinkedIn' },
  { href: googleScholar, slug: 'scholar' as const, label: 'Google Scholar' },
].filter((l) => l.href);
---

<div class:list={['social-links', className]}>
  {
    links.map((l) => (
      <a href={l.href} aria-label={l.label} target="_blank" rel="noopener noreferrer" class="social-link">
        <span
          class="social-icon-mask"
          aria-hidden="true"
          style={`--social-mask: url("${iconUrl(l.slug)}"); --social-icon-size: ${size}px`}
        />
        <span class="visually-hidden">{l.label}</span>
      </a>
    ))
  }
</div>

<style>
  .social-links {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-panel-border);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .social-link:hover {
    background: var(--color-panel);
    border-color: var(--color-accent-soft);
  }

  .social-icon-mask {
    display: block;
    width: var(--social-icon-size, 18px);
    height: var(--social-icon-size, 18px);
    opacity: 0.7;
    transition: opacity 0.15s ease;
    background-color: currentColor;
    -webkit-mask: var(--social-mask) center / contain no-repeat;
    mask: var(--social-mask) center / contain no-repeat;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .social-link .social-icon-mask {
      filter: invert(1);
    }

    :root:not([data-theme='light']) :global(body.page-resume) .social-link .social-icon-mask {
      filter: none;
    }
  }

  :root[data-theme='dark'] .social-link .social-icon-mask {
    filter: invert(1);
  }

  :root[data-theme='dark'] :global(body.page-resume) .social-link .social-icon-mask {
    filter: none;
  }

  .social-link:hover .social-icon-mask {
    opacity: 1;
  }
</style>
