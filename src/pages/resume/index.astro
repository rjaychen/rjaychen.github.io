---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ResumeSections from '../../components/resume/ResumeSections.astro';
import '../../styles/print-resume.css';

import {
  identity,
  education,
  experience,
  technicalSkills,
  softSkills,
  languagesSpoken,
  interests,
} from '../../data/resume';
import SocialLinks from '../../components/SocialLinks.astro';

const title = `${identity.name} · Resume`;
---

<SiteLayout title={title} htmlClass="view-readable-root" bodyClass="page-resume">
  <div class="u-container readable-flow">
    <header class="resume-hero page-hero">
      <p class="eyebrow">Credentials</p>
      <h1>{identity.name}</h1>
      <p class="lede">{identity.title}</p>
      <SocialLinks
        github={identity.github}
        linkedIn={identity.linkedIn}
        googleScholar={identity.googleScholar}
        class="resume-social no-print"
      />
      <div class="resume-actions no-print">
        <a class="btn-download" href="/docs/rjchen-resume.pdf" download>
          ↓ Download PDF (ATS-friendly)
        </a>
        <p class="print-hint muted">
          Print (Ctrl+P) renders a plain, ATS-compliant layout. For the best machine-readable version, use the PDF instead.
        </p>
      </div>
    </header>

    <ResumeSections
      summary={identity.summary}
      education={education}
      experience={experience}
      technicalSkills={technicalSkills}
      softSkills={softSkills}
      languagesSpoken={languagesSpoken}
      interests={interests}
    />
  </div>
</SiteLayout>

<style is:global>
  .readable-flow {
    position: relative;
    z-index: 2;
    padding-block: clamp(48px, 8vw, 96px) calc(var(--space-xl));
  }

  .page-resume.readable-surface {
    background: var(--color-bg-deep);
    color-scheme: light dark;
    color-scheme: light;
  }

  .resume-hero h1 {
    margin: var(--space-sm) 0;
    letter-spacing: -0.04em;
    font-size: clamp(2.85rem, 6vw, 4.5rem);
  }

  .resume-hero .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.7825rem;
    color: var(--color-accent);
    font-weight: 600;
  }

  .resume-hero .lede {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    max-width: 46ch;
  }

  .print-hint {
    margin-top: var(--space-lg);
    max-width: 46ch;
  }

  html.view-readable-root .page-resume {
    background: #fbfbfd;
    color-scheme: light;
    color: #1d1d1f;
    --color-text-primary: #1d1d1f;
    --color-text-muted: #6e6e73;
  }

  html.view-readable-root.page-resume,
  html.view-readable-root .page-resume {
    border: none;
  }

  body.page-resume {
    transition: none;
  }

  .resume-social {
    margin-top: var(--space-sm);
  }

  .resume-actions {
    margin-top: var(--space-lg);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: center;
  }

  .btn-download {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--color-panel-border);
    background: var(--color-panel);
    color: var(--color-text-primary);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .btn-download:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }

  .print-hint {
    margin-top: 0;
    max-width: 46ch;
    font-size: 0.875rem;
  }
</style>
