---
import SiteLayout from '../layouts/SiteLayout.astro';
import Scene3D from '../components/Scene3D.astro';
import ResumeSections from '../components/resume/ResumeSections.astro';
import {
  identity,
  education,
  experience,
  technicalSkills,
  softSkills,
  languagesSpoken,
  interests,
} from '../data/resume';
import { sitePath } from '../utils/paths';

const pageTitle = `${identity.name} · Portfolio`;
---

<SiteLayout title={pageTitle}>
  <div class="home">
    <Scene3D />

    <div class="home__content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__top">
          <div>
            <h1 id="hero-title">{identity.name}</h1>
            <p class="hero__tagline">{identity.tagline}</p>
          </div>
          <div class="view-toggle" role="group" aria-label="Presentation mode">
            <button type="button" class="view-toggle__btn is-active" data-mode="interactive" id="btn-interactive">
              Interactive
            </button>
            <button type="button" class="view-toggle__btn" data-mode="readable" id="btn-readable">
              Readable
            </button>
          </div>
        </div>

        <p class="hero__intro">{identity.summary}</p>

        <div class="hero__actions">
          <button type="button" class="btn btn--ghost btn--duck" id="btn-duck-toggle" aria-pressed="false">
            DUCK!
          </button>
          <a class="btn btn--primary" href={sitePath('resume')}>Resume</a>
          <a class="btn btn--ghost" href={sitePath('blog')}>Blog</a>
        </div>
      </section>

      <section class="readable-panel" data-readable-panel hidden>
        <ResumeSections
          summary={identity.summary}
          education={education}
          experience={experience}
          technicalSkills={technicalSkills}
          softSkills={softSkills}
          languagesSpoken={languagesSpoken}
          interests={interests}
          compact
        />
      </section>
    </div>
  </div>
</SiteLayout>

<style>
  .home {
    position: relative;
    min-height: calc(100vh - var(--header-h));
  }

  /* Content stacks above Scene3D (fixed z-index 0); pointer events pass through except scene. */
  .home__content {
    position: relative;
    z-index: var(--z-content);
    max-width: var(--layout-max);
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-lg) var(--space-2xl);
    pointer-events: none;
  }

  .home__content > * {
    pointer-events: auto;
  }

  .hero__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  body:not(.mode-readable) .hero {
    text-shadow: 0 8px 32px rgba(0, 0, 0, 0.65);
  }

  .hero__tagline {
    margin: var(--space-sm) 0 0;
    font-size: 1.05rem;
    font-weight: 500;
    max-width: 36ch;
    color: rgba(245, 245, 247, 0.92);
  }

  html.view-readable-root .hero__tagline {
    color: var(--color-text-muted);
  }

  .hero__intro {
    font-size: 1.02rem;
    max-width: 56ch;
    margin-bottom: var(--space-xl);
    color: rgba(245, 245, 247, 0.88);
  }

  html.view-readable-root .hero__intro {
    color: var(--color-text-primary);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: center;
  }

  .btn--duck {
    font: inherit;
  }

  body:not(.mode-readable) .btn--duck {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.14);
    color: rgba(245, 245, 247, 0.95);
  }

  body:not(.mode-readable) .btn--duck:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.22);
  }

  .btn--duck:disabled {
    opacity: 0.55;
    cursor: wait;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 1.15rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 500;
    border: 1px solid transparent;
    text-decoration: none;
    cursor: pointer;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .btn--primary {
    background: var(--color-accent);
    color: #fff;
  }

  .btn--primary:hover {
    filter: brightness(1.06);
    color: #fff;
  }

  .btn--ghost {
    background: var(--color-panel);
    border-color: var(--color-panel-border);
    color: var(--color-text-primary);
  }

  html.view-readable-root .btn--ghost {
    background: #fff;
    border-color: var(--color-panel-border);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
  }

  .view-toggle {
    display: inline-flex;
    padding: 4px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  html.view-readable-root .view-toggle {
    background: rgba(0, 0, 0, 0.04);
    border-color: var(--color-panel-border);
  }

  .view-toggle__btn {
    border: none;
    border-radius: 999px;
    padding: 0.45rem 1rem;
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    color: var(--color-text-muted);
    background: transparent;
  }

  html.view-readable-root .view-toggle__btn {
    color: var(--color-text-muted);
  }

  .view-toggle__btn.is-active {
    background: #fff;
    color: #0a0a0c;
    font-weight: 600;
  }

  html.view-readable-root .view-toggle__btn.is-active {
    background: var(--color-text-primary);
    color: #fff;
  }

  .readable-panel {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  html.view-readable-root .readable-panel {
    border-top-color: var(--color-panel-border);
  }

  .readable-panel[hidden] {
    display: none !important;
  }
</style>

<script>
  import type { PortfolioMountApi } from '../scripts/scene/portfolioScene';

  const STORAGE_KEY = 'rjaychen-site-mode';
  type Mode = 'interactive' | 'readable';

  const layer = document.querySelector('[data-scene-layer]') as HTMLElement | null;
  const root = document.querySelector('[data-portfolio-scene]') as HTMLElement | null;
  const canvas = document.querySelector('#portfolio-canvas') as HTMLCanvasElement | null;
  const btnI = document.getElementById('btn-interactive');
  const btnR = document.getElementById('btn-readable');
  const duckBtn = document.getElementById('btn-duck-toggle') as HTMLButtonElement | null;
  const readablePanel = document.querySelector('[data-readable-panel]') as HTMLElement | null;

  let api: PortfolioMountApi | null = null;

  function syncDuckButton(): void {
    if (!duckBtn) return;
    if (!api) {
      duckBtn.textContent = 'DUCK!';
      duckBtn.setAttribute('aria-pressed', 'false');
      return;
    }
    const glb = api.getShowGlb();
    duckBtn.textContent = glb ? 'No duck :(' : 'DUCK!';
    duckBtn.setAttribute('aria-pressed', glb ? 'true' : 'false');
  }

  function readPreference(): Mode {
    const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
    const stored = localStorage.getItem(STORAGE_KEY) as Mode | null;
    if (stored === 'interactive' || stored === 'readable') {
      return stored;
    }
    return mq.matches ? 'readable' : 'interactive';
  }

  function setButtons(mode: Mode) {
    btnI?.classList.toggle('is-active', mode === 'interactive');
    btnR?.classList.toggle('is-active', mode === 'readable');
  }

  function applyBodyMode(mode: Mode) {
    document.documentElement.classList.toggle('view-readable-root', mode === 'readable');
    document.body.classList.toggle('mode-readable', mode === 'readable');
    layer?.classList.toggle('scene-layer--hidden', mode === 'readable');
    if (readablePanel) {
      readablePanel.hidden = mode !== 'readable';
    }
    if (layer) {
      layer.setAttribute('aria-hidden', mode === 'readable' ? 'true' : 'false');
    }
    if (duckBtn) {
      duckBtn.hidden = mode === 'readable';
    }
  }

  function disposeScene() {
    api?.dispose();
    api = null;
  }

  async function bootScene(): Promise<void> {
    if (!canvas || !root || api) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const { mount } = await import('../scripts/scene/portfolioScene');
    api = mount({ canvas, container: root, reducedMotion: reduced });
    syncDuckButton();
  }

  function setMode(mode: Mode) {
    localStorage.setItem(STORAGE_KEY, mode);
    setButtons(mode);
    applyBodyMode(mode);
    if (mode === 'interactive') {
      const start = (): void => {
        void disposeScene();
        void bootScene();
      };
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(start, { timeout: 2200 });
      } else {
        setTimeout(start, 0);
      }
    } else {
      disposeScene();
    }
  }

  function init() {
    const mode = readPreference();
    setButtons(mode);
    applyBodyMode(mode);
    if (mode === 'interactive') {
      const start = (): void => {
        void bootScene();
      };
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(start, { timeout: 2200 });
      } else {
        setTimeout(start, 0);
      }
    }
  }

  duckBtn?.addEventListener('click', async () => {
    if (!api || duckBtn.hidden) return;
    const next = !api.getShowGlb();
    duckBtn.disabled = true;
    try {
      await api.setShowGlb(next);
    } catch {
      /* Load failed — remains torus */
    } finally {
      duckBtn.disabled = false;
      syncDuckButton();
    }
  });

  btnI?.addEventListener('click', () => setMode('interactive'));
  btnR?.addEventListener('click', () => setMode('readable'));

  init();
</script>
