---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { identity } from '../data/resume';
import { sitePath } from '../utils/paths';
import SocialLinks from '../components/SocialLinks.astro';

interface Props {
  title?: string;
  description?: string;
  htmlClass?: string;
  bodyClass?: string;
}

const { title = identity.name, description = identity.summary, bodyClass = '', htmlClass } = Astro.props;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;

const iconBase = `${import.meta.env.BASE_URL}icons/site/`.replace(/([^:])\/\/+/g, '$1/');
const faviconIco = `${iconBase}favicon.ico`;
const appleTouchIcon = `${iconBase}apple-touch-icon.png`;
const androidChrome192 = `${iconBase}android-chrome-192x192.png`;
const androidChrome512 = `${iconBase}android-chrome-512x512.png`;
---

<!DOCTYPE html>
<html lang="en" class:list={['theme-root', htmlClass]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Favicon & app icons (public/icons/site/) -->
    <link rel="icon" href={faviconIco} sizes="any" />
    <link rel="apple-touch-icon" href={appleTouchIcon} />
    <link rel="icon" type="image/png" sizes="192x192" href={androidChrome192} />
    <link rel="icon" type="image/png" sizes="512x512" href={androidChrome512} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.toString()} />
    <slot name="head" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:type" content="website" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content="#0a0a0c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
    <ClientRouter />
    <script is:inline>
      (function () {
        // Apply stored theme override before first paint to avoid flash
        try {
          var t = localStorage.getItem('portfolio-theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (e) {}

        // Readable layout mode
        try {
          var k = 'portfolio-view-mode';
          var s = localStorage.getItem(k);
          var mq = window.matchMedia('(prefers-reduced-motion: reduce)');
          var mode =
            s === 'interactive' || s === 'readable' ? s : mq.matches ? 'readable' : 'interactive';
          if (mode === 'readable') {
            document.documentElement.classList.add('view-readable-root');
          }
        } catch (e) {}

        // Restore accent color before first paint to avoid flash of default blue
        try {
          var accent = localStorage.getItem('portfolio-accent-color');
          if (accent && /^#[0-9a-f]{6}$/i.test(accent)) {
            document.documentElement.style.setProperty('--color-accent', accent);
            var m = accent.match(/^#([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i);
            if (m) {
              document.documentElement.style.setProperty(
                '--color-accent-soft',
                'rgba(' + parseInt(m[1], 16) + ',' + parseInt(m[2], 16) + ',' + parseInt(m[3], 16) + ',0.35)'
              );
            }
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class={`${bodyClass}`.trim()}>
    <a class="visually-hidden" href="#main">Skip to content</a>
    <header class="site-nav no-print">
      <div class="u-container site-nav-inner">
        <a class="mark" href={sitePath()}>{identity.name}</a>
        <nav aria-label="Primary">
          <a href={sitePath()} aria-current={Astro.url.pathname === sitePath() || Astro.url.pathname === '/' ? 'page' : undefined}>Home</a>
          <a
            href={sitePath('blog')}
            aria-current={Astro.url.pathname.startsWith(sitePath('blog')) ? 'page' : undefined}
            >Blog</a
          >
          <a
            href={sitePath('resume')}
            aria-current={Astro.url.pathname.startsWith(sitePath('resume')) ? 'page' : undefined}
            >Resume</a
          >
          <button
            id="theme-toggle"
            type="button"
            class="theme-toggle no-print"
            aria-label="Toggle color theme"
            title="Toggle light / dark / auto"
          >
            <!-- Sun icon (light mode indicator) -->
            <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="5"/>
              <line x1="12" y1="1" x2="12" y2="3"/>
              <line x1="12" y1="21" x2="12" y2="23"/>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
              <line x1="1" y1="12" x2="3" y2="12"/>
              <line x1="21" y1="12" x2="23" y2="12"/>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
            <!-- Moon icon (dark mode indicator) -->
            <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"/>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer no-print">
      <div class="u-container site-footer-inner">
        <span class="footer-tagline">{identity.tagline}</span>
        <SocialLinks github={identity.github} linkedIn={identity.linkedIn} googleScholar={identity.googleScholar} />
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--color-panel-border);
    background: rgba(10, 10, 14, 0.65);
    -webkit-backdrop-filter: saturate(140%) blur(18px);
    backdrop-filter: saturate(140%) blur(18px);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .site-nav {
      background: var(--color-bg-deep);
    }
  }

  .site-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    min-height: 64px;
  }

  .site-nav-inner nav {
    display: flex;
    gap: var(--space-md);
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .site-nav a {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .site-nav nav a:hover,
  .site-nav nav a:focus-visible {
    color: var(--color-text-primary);
  }

  .mark {
    font-weight: 600;
    letter-spacing: -0.02em;
    font-size: 1rem;
    color: var(--color-text-primary);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-footer {
    margin-top: var(--space-xl);
    padding: var(--space-lg) 0 calc(var(--space-lg) + 12px);
    border-top: 1px solid var(--color-panel-border);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .site-footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    justify-content: space-between;
    align-items: center;
  }

  .footer-tagline {
    max-width: 48rem;
    line-height: 1.5;
  }

  html[data-theme='light'] .site-nav {
    border-bottom-color: rgba(17, 17, 20, 0.08);
    background: rgba(245, 245, 247, 0.85);
  }

  @media (prefers-color-scheme: light) {
    html:not([data-theme='dark']) .site-nav {
      border-bottom-color: rgba(17, 17, 20, 0.08);
      background: rgba(245, 245, 247, 0.85);
    }
  }

  /*
   * Resume keeps a light paper body even under dark chrome; translucent nav + backdrop
   * would otherwise blend with that paper and look lighter than other dark-mode pages.
   */
  html[data-theme='dark'] body.page-resume .site-nav {
    border-bottom-color: var(--color-panel-border);
    background: color-mix(in srgb, var(--color-bg-deep) 94%, transparent);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  @media (prefers-color-scheme: dark) {
    html:not([data-theme='light']) body.page-resume .site-nav {
      border-bottom-color: var(--color-panel-border);
      background: color-mix(in srgb, var(--color-bg-deep) 94%, transparent);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  /* ---- Theme toggle button ---- */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid var(--color-panel-border);
    border-radius: 50%;
    background: var(--color-panel);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    flex-shrink: 0;
  }

  .theme-toggle:hover {
    color: var(--color-text-primary);
    background: var(--color-panel-border);
  }

  /* Show sun in dark mode, moon in light mode */
  .icon-sun  { display: none; }
  .icon-moon { display: block; }

  html[data-theme='light'] .icon-sun,
  html[data-theme='light'] ~ * .icon-sun { display: block; }
  html[data-theme='light'] .icon-moon,
  html[data-theme='light'] ~ * .icon-moon { display: none; }

  @media (prefers-color-scheme: light) {
    html:not([data-theme='dark']) .icon-sun  { display: block; }
    html:not([data-theme='dark']) .icon-moon { display: none; }
  }
</style>

<script>
  import { applyAccent, loadStoredAccent } from '../scripts/scene/accentTheme';

  const THEME_STORAGE_KEY = 'portfolio-theme';
  const root = document.documentElement;
  let mqListener: (() => void) | null = null;

  function getEffectiveTheme(): 'light' | 'dark' {
    const stored = root.getAttribute('data-theme') as 'light' | 'dark' | null;
    if (stored === 'light' || stored === 'dark') return stored;
    return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
  }

  /** View transitions swap `<html>` without inline boot script — restore explicit theme choice. */
  function applyStoredTheme(): void {
    try {
      const t = localStorage.getItem(THEME_STORAGE_KEY);
      if (t === 'light' || t === 'dark') {
        root.setAttribute('data-theme', t);
      } else {
        root.removeAttribute('data-theme');
      }
    } catch {}
  }

  /** Align HUD color pickers + CSS accent with storage after swapped markup resets inputs. */
  function applyStoredAccent(): void {
    const hex = loadStoredAccent();
    applyAccent(hex);
    for (const el of document.querySelectorAll('[data-scene-accent]')) {
      if (el instanceof HTMLInputElement) el.value = hex;
    }
  }

  function restorePersistedChrome(): void {
    applyStoredTheme();
    applyStoredAccent();
  }

  function bindThemeToggle(): void {
    restorePersistedChrome();

    const existing = document.getElementById('theme-toggle');
    if (!existing) return;
    existing.replaceWith(existing.cloneNode(true));
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    const updateIcons = (): void => {
      const effective = getEffectiveTheme();
      const sun = btn.querySelector('.icon-sun') as HTMLElement | null;
      const moon = btn.querySelector('.icon-moon') as HTMLElement | null;
      if (sun) sun.style.display = effective === 'light' ? 'block' : 'none';
      if (moon) moon.style.display = effective === 'dark' ? 'block' : 'none';
    };

    const onClick = (): void => {
      const current = getEffectiveTheme();
      const next = current === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem(THEME_STORAGE_KEY, next);
      } catch {}
      updateIcons();
    };

    btn.addEventListener('click', onClick);

    if (mqListener) {
      window.matchMedia('(prefers-color-scheme: light)').removeEventListener('change', mqListener);
    }
    mqListener = () => updateIcons();
    window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', mqListener);
    updateIcons();
  }

  bindThemeToggle();
  document.addEventListener('astro:after-swap', restorePersistedChrome);
  document.addEventListener('astro:page-load', bindThemeToggle);
</script>
